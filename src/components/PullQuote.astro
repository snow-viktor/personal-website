---
export interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<blockquote class="pull-quote">
  <span class="pull-quote-mark" aria-hidden="true">&ldquo;</span>
  <div class="pull-quote-text">
    <slot />
  </div>
  {attribution && <cite class="pull-quote-attribution">&mdash; {attribution}</cite>}
</blockquote>

<style>
  .pull-quote {
    position: relative;
    border: none;
    padding: 1.5rem 0 1.5rem 2rem;
    margin: 2rem 0;
    font-style: normal;
    color: var(--text);
  }

  .pull-quote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--accent-gold-muted);
    border-radius: 1px;
  }

  .pull-quote-mark {
    position: absolute;
    left: 0.25rem;
    top: 0;
    font-size: 3rem;
    line-height: 1;
    color: var(--accent-gold);
    opacity: 0.4;
    font-family: Georgia, 'Times New Roman', serif;
    pointer-events: none;
  }

  .pull-quote-text {
    font-size: 1.125rem;
    line-height: 1.7;
    font-style: italic;
    color: var(--text);
  }

  .pull-quote-text :global(p) {
    margin-bottom: 0;
  }

  .pull-quote-attribution {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-style: normal;
    color: var(--text-dim);
  }
</style>
