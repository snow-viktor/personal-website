---
import { formatDate } from '../lib/utils';

export interface Props {
  title: string;
  date: Date;
  type: string;
  tags: string[];
  summary: string;
  url: string;
}

const { title, date, type, tags, summary, url } = Astro.props;
---

<article class="card project-card">
  <div class="project-card-header">
    <span class="type-badge">{type}</span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
  <h2 class="project-card-title"><a href={url}>{title}</a></h2>
  <p class="project-card-summary">{summary}</p>
  {tags.length > 0 && (
    <div class="project-card-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .project-card-title {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  /* Stretched link: the accessible name is the title alone (not meta +
     summary + every tag), while the hit area stays the whole card. */
  .project-card-title a {
    color: var(--text);
    transition: color 0.2s ease;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      cursor: pointer;
    }

    &:hover {
      color: var(--accent);
    }

    /* The ::after ring mirrors the real click target; the anchor's own
       ring is suppressed only because this one replaces it. */
    &:focus-visible {
      outline: none;

      &::after {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    }
  }

  .project-card-summary {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Equal-height grid rows stretch the card; the tag row absorbs the slack
     so tags meet the bottom edge even when the summary runs short. The
     padding keeps the ArticleCard-parity 0.5rem minimum gap. */
  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6rem;
    row-gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
