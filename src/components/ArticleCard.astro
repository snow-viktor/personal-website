---
import { truncate, formatDate } from '../lib/utils';

export interface Props {
  title: string;
  date: Date;
  tags: string[];
  collection?: string;
  summary: string;
  url: string;
}

const { title, date, tags, collection, summary, url } = Astro.props;
---

<article class="card article-card">
  <div class="article-card-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {collection && <span class="collection-mark">{collection}</span>}
  </div>
  <h2 class="article-card-title"><a href={url}>{title}</a></h2>
  <p class="article-card-summary">{truncate(summary)}</p>
  {tags.length > 0 && (
    <div class="article-card-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</article>

<style>
  .article-card {
    position: relative;
    padding: 1.25rem;
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .article-card-title {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  /* Stretched link: the accessible name is the title alone (not meta +
     summary + every tag), while the hit area stays the whole card. */
  .article-card-title a {
    color: var(--text);
    transition: color 0.2s ease;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      cursor: pointer;
    }

    &:hover {
      color: var(--accent);
    }

    /* The ::after ring mirrors the real click target; the anchor's own
       ring is suppressed only because this one replaces it. */
    &:focus-visible {
      outline: none;

      &::after {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    }
  }

  .article-card-summary {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .collection-mark {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--accent-green);
    padding-left: 0.6rem;
    position: relative;
    text-transform: lowercase;

    &::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--accent-green);
    }
  }

  .article-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }
</style>
