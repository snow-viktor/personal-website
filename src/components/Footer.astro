---
import { SITE, SOCIAL_LINKS, QUOTES } from '../config';

function quoteMark(lang: string, side: 'open' | 'close'): string {
  if (lang === 'zh') return side === 'open' ? '「' : '」';
  return side === 'open' ? '&ldquo;' : '&rdquo;';
}
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Social media">
      {SOCIAL_LINKS.map((link) => (
        <a href={link.href} class="footer-icon" target="_blank" rel="noopener" aria-label={link.label}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      ))}
    </nav>
    <div class="footer-quote" id="footer-quote" data-quotes={JSON.stringify(QUOTES)}>
      <span class="quote-mark" id="quote-mark-open" set:html={quoteMark(QUOTES[0].lang, 'open')}></span>
      <span class="quote-text" id="quote-text" lang={QUOTES[0].lang}>{QUOTES[0].text}</span>
      <span class="quote-mark" id="quote-mark-close" set:html={quoteMark(QUOTES[0].lang, 'close')}></span>
      <span class="quote-author" id="quote-author">&mdash; {QUOTES[0].author}</span>
    </div>
    <p class="footer-text">&copy; {new Date().getFullYear()} {SITE.name} &middot; Code <a href="/MIT/" class="footer-text-link">MIT</a> &middot; Content <a href="/CC-BY-NC-4.0/" class="footer-text-link">CC BY-NC 4.0</a></p>
  </div>
</footer>

<script>
  const container = document.getElementById('footer-quote')!;
  const quotes = JSON.parse(container.dataset.quotes ?? '[]');

  function quoteMark(lang, side) {
    if (lang === 'zh') return side === 'open' ? '\u300C' : '\u300D';
    return side === 'open' ? '\u201C' : '\u201D';
  }

  let index = 0;
  const textEl = document.getElementById('quote-text');
  const authorEl = document.getElementById('quote-author');
  const openMark = document.getElementById('quote-mark-open');
  const closeMark = document.getElementById('quote-mark-close');

  function cycleQuote() {
    index = (index + 1) % quotes.length;
    container.classList.add('fade');
    setTimeout(() => {
      textEl.textContent = quotes[index].text;
      textEl.lang = quotes[index].lang;
      authorEl.innerHTML = '\u2014 ' + quotes[index].author;
      openMark.textContent = quoteMark(quotes[index].lang, 'open');
      closeMark.textContent = quoteMark(quotes[index].lang, 'close');
      container.classList.remove('fade');
    }, 400);
  }

  setInterval(cycleQuote, 10000);
</script>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--text-dim);
    transition: color 0.2s, background 0.2s;

    &:hover {
      color: var(--accent);
      background: var(--accent-muted);
    }
  }

  .footer-quote {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.15em;
    max-width: 28rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    transition: opacity 0.4s ease;

    &.fade {
      opacity: 0;
    }
  }

  .quote-mark {
    font-size: 0.75rem;
    color: var(--accent-gold);
    opacity: 0.6;
    vertical-align: super;
  }

  .quote-text {
    font-style: italic;
  }

  .quote-text[lang="zh"] {
    font-style: normal;
  }

  .quote-author {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .footer-text {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin: 0;
  }

  .footer-text a {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .footer-text a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .footer-text-link {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .footer-text-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
