---
const links = [
  {
    href: 'https://github.com/snow-viktor',
    label: 'GitHub',
    path: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
  },
  {
    href: 'https://youtube.com/@SnowViktor',
    label: 'YouTube',
    path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
];

const quotes: Array<{ text: string; author: string; lang: string }> = [
  { text: 'Simplicity is the ultimate sophistication.', author: 'Leonardo da Vinci', lang: 'en' },
  { text: 'The best way to predict the future is to invent it.', author: 'Alan Kay', lang: 'en' },
  { text: 'Make it work, make it right, make it fast.', author: 'Kent Beck', lang: 'en' },
];

function quoteMark(lang: string, side: 'open' | 'close'): string {
  if (lang === 'zh') return side === 'open' ? '「' : '」';
  return side === 'open' ? '&ldquo;' : '&rdquo;';
}
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Social media">
      {links.map((link) => (
        <a href={link.href} class="footer-icon" target="_blank" rel="noopener" aria-label={link.label}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      ))}
    </nav>
    <div class="footer-quote" id="footer-quote" data-quotes={JSON.stringify(quotes).replace(/"/g, '&quot;')}>
      <span class="quote-mark" id="quote-mark-open" set:html={quoteMark(quotes[0].lang, 'open')}></span>
      <span class="quote-text" id="quote-text" lang={quotes[0].lang}>{quotes[0].text}</span>
      <span class="quote-mark" id="quote-mark-close" set:html={quoteMark(quotes[0].lang, 'close')}></span>
      <span class="quote-author" id="quote-author">&mdash; {quotes[0].author}</span>
    </div>
    <p class="footer-text">&copy; {new Date().getFullYear()} SnowViktor &middot; Code <a href="/LICENSE-MIT">MIT</a> &middot; Content <a href="/LICENSE-CC-BY-NC-4.0">CC BY-NC 4.0</a></p>
  </div>
</footer>

<script>
  const container = document.getElementById('footer-quote')!;
  const quotes = JSON.parse(container.dataset.quotes ?? '[]');

  function quoteMark(lang, side) {
    if (lang === 'zh') return side === 'open' ? '\u300C' : '\u300D';
    return side === 'open' ? '\u201C' : '\u201D';
  }

  let index = 0;
  const textEl = document.getElementById('quote-text');
  const authorEl = document.getElementById('quote-author');
  const openMark = document.getElementById('quote-mark-open');
  const closeMark = document.getElementById('quote-mark-close');

  function cycleQuote() {
    index = (index + 1) % quotes.length;
    container.classList.add('fade');
    setTimeout(() => {
      textEl.textContent = quotes[index].text;
      textEl.lang = quotes[index].lang;
      authorEl.innerHTML = '\u2014 ' + quotes[index].author;
      openMark.textContent = quoteMark(quotes[index].lang, 'open');
      closeMark.textContent = quoteMark(quotes[index].lang, 'close');
      container.classList.remove('fade');
    }, 400);
  }

  setInterval(cycleQuote, 10000);
</script>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--text-dim);
    transition: color 0.2s, background 0.2s;

    &:hover {
      color: var(--accent);
      background: var(--accent-muted);
    }
  }

  .footer-quote {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.15em;
    max-width: 28rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    transition: opacity 0.4s ease;

    &.fade {
      opacity: 0;
    }
  }

  .quote-mark {
    font-size: 0.75rem;
    color: var(--accent-gold);
    opacity: 0.6;
    vertical-align: super;
  }

  .quote-text {
    font-style: italic;
  }

  .quote-text[lang="zh"] {
    font-style: normal;
  }

  .quote-author {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .footer-text {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin: 0;
  }

  .footer-text a {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .footer-text a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
