---
import { SITE, SOCIAL_LINKS } from '../config';
import { getQuoteCategories } from '../lib/content';

function quoteMark(lang: string, side: 'open' | 'close'): string {
  if (lang === 'zh') return side === 'open' ? '「' : '」';
  return side === 'open' ? '&ldquo;' : '&rdquo;';
}

const categories = await getQuoteCategories();
const flat = categories.flatMap((category) => category.quotes);
const flagged = flat.filter((quote) => quote.footer);
const quotes = (flagged.length > 0 ? flagged : flat).map(({ text, source, lang }) => ({
  text,
  source: source ?? '',
  lang,
}));
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Social media">
      {SOCIAL_LINKS.map((link) => (
        <a href={link.href} class="footer-icon" target="_blank" rel="noopener" aria-label={link.label}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      ))}
    </nav>
    <div class="footer-quote" id="footer-quote" data-quotes={JSON.stringify(quotes)}>
      <span class="quote-mark" id="quote-mark-open" set:html={quoteMark(quotes[0].lang, 'open')}></span>
      <span class="quote-text" id="quote-text" lang={quotes[0].lang}>{quotes[0].text}</span>
      <span class="quote-mark" id="quote-mark-close" set:html={quoteMark(quotes[0].lang, 'close')}></span>
      <span class="quote-source" id="quote-source">&mdash; {quotes[0].source}</span>
    </div>
    <a href="/quotes/" class="footer-quotes-link">Quotes</a>
    <p class="footer-text">&copy; {new Date().getFullYear()} {SITE.name} &middot; Code <a href="/MIT.txt" class="footer-text-link">MIT</a> &middot; Content <a href="/CC-BY-NC-4.0.txt" class="footer-text-link">CC BY-NC 4.0</a></p>
  </div>
</footer>

<script>
  interface FooterQuote {
    text: string;
    source: string;
    lang: string;
  }

  type QuoteMarkSide = 'open' | 'close';

  const container = document.getElementById('footer-quote')!;
  const quotes = JSON.parse(container.dataset.quotes ?? '[]') as FooterQuote[];

  // Rotate in random order (Fisher–Yates), but keep the server-rendered
  // quote first so the opening display still matches what was built.
  if (quotes.length > 1) {
    const first = quotes.shift()!;
    for (let i = quotes.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [quotes[i], quotes[j]] = [quotes[j]!, quotes[i]!];
    }
    quotes.unshift(first);
  }

  function quoteMark(lang: string, side: QuoteMarkSide): string {
    if (lang === 'zh') return side === 'open' ? '\u300C' : '\u300D';
    return side === 'open' ? '\u201C' : '\u201D';
  }

  let index = 0;
  const textEl = document.getElementById('quote-text')!;
  const sourceEl = document.getElementById('quote-source')!;
  const openMark = document.getElementById('quote-mark-open')!;
  const closeMark = document.getElementById('quote-mark-close')!;

  function cycleQuote(): void {
    if (quotes.length === 0) return;
    index = (index + 1) % quotes.length;
    const quote = quotes[index];
    if (!quote) return;
    container.classList.add('fade');
    setTimeout(() => {
      textEl.textContent = quote.text;
      textEl.lang = quote.lang;
      sourceEl.innerHTML = quote.source ? '\u2014 ' + quote.source : '';
      openMark.textContent = quoteMark(quote.lang, 'open');
      closeMark.textContent = quoteMark(quote.lang, 'close');
      container.classList.remove('fade');
    }, 400);
  }

  // Auto-cycling motion: off under reduced-motion, paused while hovered.
  // focusin/focusout were no-ops here — the quote container has no focusable
  // children, so events never fired; removed rather than left pretending.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && quotes.length > 1) {
    let timer: ReturnType<typeof setInterval> = setInterval(cycleQuote, 7000);
    const pause = () => clearInterval(timer);
    const resume = () => {
      pause();
      timer = setInterval(cycleQuote, 7000);
    };
    container.addEventListener('mouseenter', pause);
    container.addEventListener('mouseleave', resume);
  }
</script>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--text-dim);
    transition: color 0.2s, background 0.2s;

    &:hover {
      color: var(--accent);
      background: var(--accent-muted);
    }
  }

  .footer-quote {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.15em;
    max-width: 28rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    transition: opacity 0.4s ease;

    &.fade {
      opacity: 0;
    }
  }

  /* Same size as the quote text; the source below is the only smaller voice. */
  .quote-mark {
    color: var(--accent-gold);
    opacity: 0.6;
  }

  .quote-text {
    font-style: italic;
  }

  .quote-text[lang="zh"] {
    font-style: normal;
  }

  .quote-source {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
    align-self: center;
  }

  .footer-text {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin: 0;
  }

  .footer-quotes-link {
    font-size: 0.8125rem;
  }

  .footer-text a,
  .footer-quotes-link {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .footer-text a:hover,
  .footer-quotes-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
