---
import BaseLayout from '../../layouts/BaseLayout.astro';
import components from '../../components/mdx';
import { getEntry, render } from 'astro:content';
import { getPublishedProjects } from '../../lib/content';
import { formatDate, truncate } from '../../lib/utils';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { id: project.id, allProjects: projects },
  }));
}

const { id, allProjects } = Astro.props;
const entry = await getEntry('projects', id);
const { Content } = await render(entry);

const description = entry.body ? truncate(entry.body) : entry.data.title;

const currentIndex = allProjects.findIndex((p) => p.id === id);
const prev = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description,
  datePublished: entry.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  keywords: entry.data.tags.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={entry.data.title} description={description} jsonLd={projectJsonLd}>
  <article class="container container--narrow page">
    <header class="project-header">
      <div class="project-meta">
        <span class="type-badge">{entry.data.type}</span>
        <time datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date)}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.tags.length > 0 && (
        <div class="project-tags">
          {entry.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      {entry.data.links.length > 0 && (
        <div class="project-links">
          {entry.data.links.map((link: { label: string; url: string }) => (
            <a href={link.url} class="project-link" target="_blank" rel="noopener">
              {link.label} &nearr;
            </a>
          ))}
        </div>
      )}
    </header>
    <div class="project-content">
      <Content components={components} />
    </div>
  </article>
  <div class="container container--narrow">
    {prev || next ? (
      <nav class="project-nav">
        <div class="project-nav-prev">
          {prev && (
            <a href={`/projects/${prev.id}/`}>
              <span class="project-nav-label">&larr; Previous</span>
              <span class="project-nav-title">{prev.data.title}</span>
            </a>
          )}
        </div>
        <div class="project-nav-next">
          {next && (
            <a href={`/projects/${next.id}/`}>
              <span class="project-nav-label">Next &rarr;</span>
              <span class="project-nav-title">{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    ) : (
      <a href="/projects/" class="back-link">&larr; Back to Projects</a>
    )}
  </div>
</BaseLayout>

<style>
  .project-header {
    margin-bottom: 2.5rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s, color 0.2s;

    &:hover {
      border-color: var(--accent);
    }
  }

  .project-content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .project-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-accent);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-dim);
    margin-top: 1rem;
    transition: color 0.2s;

    &:hover {
      color: var(--accent);
    }
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .project-nav-prev,
  .project-nav-next {
    display: flex;
    min-width: 0;
  }

  .project-nav-next {
    justify-content: flex-end;
    text-align: right;
  }

  .project-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    min-width: 0;
  }

  .project-nav-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .project-nav-title {
    font-size: 0.875rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }

  .project-nav a:hover .project-nav-title {
    color: var(--accent);
  }
</style>
