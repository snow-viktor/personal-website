---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import components from '../../components/mdx';
import { getEntry, render } from 'astro:content';
import { getPublishedProjects } from '../../lib/content';
import { formatDate, truncate } from '../../lib/utils';
import { SITE } from '../../config';

// Neighbor calculation happens here, not at render time: the base path never
// varies per query, and we avoid shipping every other project's body through
// each page's props just to find its neighbors.
export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      id: project.id,
      prev: index > 0 ? { title: projects[index - 1].data.title, url: `/projects/${projects[index - 1].id}/` } : undefined,
      next:
        index < projects.length - 1
          ? { title: projects[index + 1].data.title, url: `/projects/${projects[index + 1].id}/` }
          : undefined,
    },
  }));
}

const { id, prev, next } = Astro.props;
const entry = await getEntry('projects', id);
const { Content } = await render(entry);

const description = entry.body ? truncate(entry.body) : entry.data.title;

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description,
  datePublished: entry.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  keywords: entry.data.tags.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={entry.data.title} description={description} jsonLd={projectJsonLd}>
  <article class="container container--narrow page">
    <header class="project-header">
      <div class="project-meta">
        <span class="type-badge">{entry.data.type}</span>
        <time datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date)}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.tags.length > 0 && (
        <div class="project-tags">
          {entry.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      {entry.data.links.length > 0 && (
        <div class="project-links">
          {entry.data.links.map((link: { label: string; url: string }) => (
            <a href={link.url} class="project-link" target="_blank" rel="noopener">
              {link.label} &nearr;
            </a>
          ))}
        </div>
      )}
    </header>
    <div class="project-content">
      <Content components={components} />
    </div>
  </article>
  <PrevNext
    prev={prev}
    next={next}
    ariaLabel="專案切換"
    back={{ href: '/projects/', label: '← Back to Projects' }}
  />
</BaseLayout>

<style>
  .project-header {
    margin-bottom: 2.5rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s, color 0.2s;

    &:hover {
      border-color: var(--accent);
    }
  }

  .project-content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .project-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-accent);
  }
</style>
