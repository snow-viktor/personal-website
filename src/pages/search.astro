---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all articles and projects">
  <div class="container container--narrow page">
    <h1 class="page-title">Search <span id="search-count" class="page-count" aria-hidden="true"></span></h1>
    <div id="search-container">
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          id="search-input"
          type="search"
          class="search-input"
          placeholder="Search articles and projects…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search articles and projects"
        />
        <button id="search-clear" class="search-clear" type="button" aria-label="清除搜尋" hidden>×</button>
        <kbd id="search-kbd" class="search-kbd" aria-hidden="true">Ctrl K</kbd>
      </div>
      <div class="search-meta">
        <span id="search-status" class="search-status" aria-live="polite" aria-atomic="true"></span>
      </div>
      <div id="search-results" class="search-results"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    tokenize,
    escapeHtml,
    getQueryTerms,
    buildHighlightPattern,
    highlightWithPattern,
    extractSnippetForTerms,
  } from '../lib/search-client';
  import type { SearchDoc } from '../lib/search';

  // INP budget guard: one giant innerHTML for every match (plus dozens of
  // animated cards) blocks the main thread on each keystroke. Paint the first
  // batch synchronously for a fast next paint, then stream the rest in
  // background chunks — all results are shown, none dropped.
  const RENDER_BATCH = 25;
  // Small index chunks + a real task yield between them keep each block under
  // ~50ms so typing/clicking during load stays responsive.
  const INDEX_CHUNK = 8;

  const dateFormatter = new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });

  function formatDate(iso: string): { text: string; datetime: string } {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return { text: iso.slice(0, 10), datetime: iso };
    return { text: dateFormatter.format(d), datetime: d.toISOString() };
  }

  // Per-doc work done ONCE after fetch (escape, lowercase, date) instead of
  // once per result per keystroke inside renderResults.
  interface PreparedDoc extends SearchDoc {
    bodyLower: string;
    dateText: string;
    dateTime: string;
    titleHtml: string;
    tagsHtml: string;
  }

  function prepareDoc(doc: SearchDoc): PreparedDoc {
    const { text, datetime } = formatDate(doc.date);
    return {
      ...doc,
      bodyLower: doc.body.toLowerCase(),
      dateText: text,
      dateTime: datetime,
      titleHtml: escapeHtml(doc.title),
      tagsHtml: doc.tags?.length
        ? `<div class="search-result-tags">${doc.tags.map((t: string) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>`
        : '',
    };
  }

  // setTimeout(0) yields to pending input/paint; rAF alone can starve behind
  // continuous frame callbacks while indexing saturates the main thread.
  function yieldToMain(): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, 0));
  }

  async function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results')!;
    const statusEl = document.getElementById('search-status')!;
    const countEl = document.getElementById('search-count')!;
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
    const kbdEl = document.getElementById('search-kbd')!;
    if (/mac|iphone|ipad/i.test(navigator.platform + ' ' + navigator.userAgent)) {
      kbdEl.textContent = '⌘K';
    }

    const docsById = new Map<string, PreparedDoc>();
    let docs: PreparedDoc[] = [];
    let ready = false;
    // Bumped on every new search so a stale background stream aborts instead
    // of appending cards for a superseded query.
    let renderGen = 0;
    // Deep-link support (?q=), matching the SearchAction URL in BaseLayout.
    // Stashed early so keystrokes typed while the index loads aren't dropped.
    let pendingQuery = new URLSearchParams(window.location.search).get('q') ?? '';

    const renderEmpty = () => {
      resultsEl.innerHTML = `
        <div class="search-empty">
          <span class="search-empty-icon" aria-hidden="true">∅</span>
          <h2 class="search-empty-title">空空如也</h2>
          <p class="search-empty-text">∵你還沒搜尋　∴什麼都沒有</p>
        </div>`;
    };

    // miniSearch is assigned after the dynamic import below; runSearch only
    // touches it once `ready` is true.
    let miniSearch: { search: (q: string) => { id: string }[]; addAll: (d: SearchDoc[]) => void } | null = null;

    const renderResults = (query: string, matches: { id: string }[]) => {
      const gen = ++renderGen;
      const total = matches.length;
      statusEl.textContent = `${total} result${total === 1 ? '' : 's'}`;
      countEl.textContent = `${total}`;

      if (total === 0) {
        resultsEl.innerHTML = `
          <div class="search-no-results">
            <p class="search-no-results-text">揣無「${escapeHtml(query)}」</p>
          </div>`;
        return;
      }

      // Tokenize + compile the highlight pattern once per search, not once
      // per rendered card.
      const terms = getQueryTerms(query);
      const lowerTerms = terms.map((t) => t.toLowerCase());
      const pattern = buildHighlightPattern(terms);

      const cardHtml = ({ id }: { id: string }): string => {
        const r = docsById.get(id)!;
        const snippet = extractSnippetForTerms(r.body, r.bodyLower, lowerTerms);
        return `
          <a href="${r.url}" class="search-result">
            <div class="search-result-header">
              <span class="type-badge">${escapeHtml(r.type)}</span>
              <time class="search-result-date" datetime="${escapeHtml(r.dateTime)}">${escapeHtml(r.dateText)}</time>
            </div>
            <h2 class="search-result-title">${highlightWithPattern(r.titleHtml, pattern)}</h2>
            ${snippet ? `<p class="search-result-snippet">${highlightWithPattern(escapeHtml(snippet), pattern)}</p>` : ''}
            ${r.tagsHtml}
          </a>`;
      };

      // First batch paints synchronously (fast next paint); the remainder
      // streams in without blocking typing, clicking, or scrolling.
      // The status keeps the final total throughout so the aria-live region
      // isn't spammed once per chunk.
      const first = matches.slice(0, RENDER_BATCH);
      resultsEl.innerHTML = first.map(cardHtml).join('');
      let rendered = first.length;

      const appendNext = (): void => {
        if (gen !== renderGen) return;
        const next = matches.slice(rendered, rendered + RENDER_BATCH);
        if (next.length === 0) return;
        resultsEl.insertAdjacentHTML('beforeend', next.map(cardHtml).join(''));
        rendered += next.length;
        if (rendered < total) void yieldToMain().then(appendNext);
      };

      if (rendered < total) void yieldToMain().then(appendNext);
    };

    const runSearch = (raw: string, { syncUrl = true } = {}) => {
      const query = raw.trim();
      clearBtn.hidden = query.length === 0;
      // Cancel any in-flight background stream from the previous query.
      renderGen++;
      if (syncUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
      if (!ready || !miniSearch) {
        pendingQuery = query;
        return;
      }
      if (!query) {
        pendingQuery = '';
        statusEl.textContent = `${docs.length} documents indexed`;
        countEl.textContent = `${docs.length}`;
        renderEmpty();
        return;
      }
      pendingQuery = '';
      renderResults(query, miniSearch.search(query));
    };

    // Attach listeners BEFORE the index loads so the field stays responsive
    // (and keystrokes aren't dropped) while indexing yields in the background.
    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      const value = input.value;
      // Keep the clear button in sync immediately; the heavy search stays debounced.
      clearBtn.hidden = value.trim().length === 0;
      timer = setTimeout(() => runSearch(value), 250);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      runSearch('');
      input.focus();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        input.focus();
      }
    });

    if (pendingQuery) input.value = pendingQuery;
    renderEmpty();

    const MiniSearch = (await import('minisearch')).default;

    miniSearch = new MiniSearch({
      fields: ['title', 'body'],
      // Body is looked up from docsById for snippets; excluding it from stored
      // fields keeps every result object small.
      storeFields: ['title', 'url', 'type', 'tags', 'date'],
      tokenize,
      processTerm: (term: string) => (term.length > 0 ? term : null),
      searchOptions: {
        boost: { title: 3, body: 1 },
        prefix: true,
        fuzzy: 0.15,
        combineWith: 'AND',
      },
    });

    try {
      statusEl.textContent = 'Loading search index…';
      resultsEl.innerHTML = `<div class="search-skeleton" aria-hidden="true"><div class="search-skeleton-card"></div><div class="search-skeleton-card"></div><div class="search-skeleton-card"></div></div>`;
      const res = await fetch('/api/search-index.json');
      const rawDocs = (await res.json()) as SearchDoc[];

      for (let i = 0; i < rawDocs.length; i += INDEX_CHUNK) {
        const slice = rawDocs.slice(i, i + INDEX_CHUNK);
        miniSearch.addAll(slice);
        for (const d of slice) {
          const prepared = prepareDoc(d);
          docs.push(prepared);
          docsById.set(d.id, prepared);
        }
        if (i + INDEX_CHUNK < rawDocs.length) await yieldToMain();
      }
    } catch {
      statusEl.textContent = 'Search index failed to load';
      resultsEl.innerHTML = `
        <div class="search-no-results">
          <p class="search-no-results-text">搜尋索引載入失敗 — 請重新整理再試一次。</p>
        </div>`;
      return;
    }

    ready = true;
    statusEl.textContent = `${docs.length} documents indexed`;
    countEl.textContent = `${docs.length}`;

    renderEmpty();
    const initialQuery = pendingQuery || input.value.trim();
    if (initialQuery) {
      input.value = initialQuery;
      runSearch(initialQuery, { syncUrl: false });
    }
  }

  initSearch();
</script>

<style>
  .page-title {
    margin-bottom: 2rem;
  }

  .page-count {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-dim);
    margin-inline-start: 0.5rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-dim);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 6rem 0.875rem 2.75rem;
    font-size: 1rem;
    font-family: var(--font);
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.2s ease;

    &::placeholder {
      color: var(--text-dim);
    }

    &:focus {
      border-color: var(--accent);
    }

    /* Keyboard focus gets the ring alone — not ring + tinted border. */
    &:focus-visible {
      border-color: var(--border);
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .search-clear {
    position: absolute;
    right: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--text-dim);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 150ms ease-out, transform 150ms ease-out;

    &:hover {
      color: var(--text);
    }

    &:active {
      transform: scale(0.97);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    &[hidden] {
      display: none;
    }
  }

  .search-kbd {
    position: absolute;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    padding: 0.15em 0.45em;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    pointer-events: none;
  }

  .search-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .search-status {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .search-kbd {
      display: none;
    }

    .search-input {
      padding-right: 2.75rem;
    }

    .search-clear {
      right: 0.75rem;
    }
  }
</style>
