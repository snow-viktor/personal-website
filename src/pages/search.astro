---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all articles and projects">
  <div class="container container--narrow page">
    <h1 class="page-title">Search</h1>
    <div id="search-container">
      <div class="search-input-wrapper">
        <input
          id="search-input"
          type="search"
          class="search-input"
          placeholder="Search articles and projects…"
          autocomplete="off"
          spellcheck="false"
        />
        <span id="search-status" class="search-status"></span>
      </div>
      <div id="search-results" class="search-results"></div>
    </div>
  </div>
</BaseLayout>

<script>
  async function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results')!;
    const statusEl = document.getElementById('search-status')!;

    const MiniSearch = (await import('minisearch')).default;

    // CJK tokenizer using Intl.Segmenter
    const segmenter =
      typeof Intl.Segmenter !== 'undefined'
        ? new Intl.Segmenter('zh-CN', { granularity: 'word' })
        : null;

    function isCJK(char: string): boolean {
      const code = char.charCodeAt(0);
      return (
        (code >= 0x4e00 && code <= 0x9fff) ||
        (code >= 0x3400 && code <= 0x4dbf) ||
        (code >= 0x2e80 && code <= 0x2eff)
      );
    }

    function tokenize(text: string): string[] {
      const tokens: string[] = [];
      const chars = [...text];

      let i = 0;
      while (i < chars.length) {
        if (isCJK(chars[i])) {
          let j = i;
          while (j < chars.length && isCJK(chars[j])) j++;
          const cjkSegment = chars.slice(i, j).join('');

          if (segmenter) {
            const segments = segmenter.segment(cjkSegment);
            for (const seg of segments) {
              if (seg.isWordLike) {
                tokens.push(seg.segment.toLowerCase());
              }
            }
          }

          // also index bigrams for CJK
          const cjkText = cjkSegment.toLowerCase();
          for (let k = 0; k < cjkText.length - 1; k++) {
            tokens.push(cjkText.slice(k, k + 2));
          }
          // single chars too
          if (cjkText.length === 1) tokens.push(cjkText);

          i = j;
        } else {
          let j = i;
          while (j < chars.length && !isCJK(chars[j]) && chars[j] !== ' ') j++;
          if (j > i) {
            const word = chars.slice(i, j).join('').toLowerCase();
            tokens.push(word);
            i = j;
          } else {
            i++;
          }
        }
      }

      return tokens;
    }

    const miniSearch = new MiniSearch({
      fields: ['title', 'body'],
      storeFields: ['title', 'url', 'type', 'tags', 'date', 'body'],
      tokenize,
      processTerm: (term: string) => (term.length > 0 ? term : null),
      searchOptions: {
        boost: { title: 3, body: 1 },
        prefix: true,
        fuzzy: 0.15,
        combineWith: 'AND',
      },
    });

    // Fetch the pre-built index
    statusEl.textContent = 'Loading search index…';
    const res = await fetch('/api/search-index.json');
    const docs = await res.json();
    miniSearch.addAll(docs);
    statusEl.textContent = `${docs.length} documents indexed`;

    function extractSnippet(
      text: string,
      query: string,
      contextLen: number = 60
    ): string | null {
      const lower = text.toLowerCase();
      const qLower = query.toLowerCase();
      const idx = lower.indexOf(qLower);
      if (idx === -1) return null;

      const start = Math.max(0, idx - contextLen);
      const end = Math.min(text.length, idx + qLower.length + contextLen);
      let snippet = text.slice(start, end);

      if (start > 0) snippet = '…' + snippet;
      if (end < text.length) snippet = snippet + '…';

      return snippet;
    }

    input.addEventListener('input', () => {
      const query = input.value.trim();
      if (!query) {
        resultsEl.innerHTML = '';
        statusEl.textContent = `${docs.length} documents indexed`;
        return;
      }

      const results = miniSearch.search(query);
      statusEl.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;

      if (results.length === 0) {
        resultsEl.innerHTML = `<p class="no-results">No results for "${query}"</p>`;
        return;
      }

      resultsEl.innerHTML = results
        .map(
          (r: any) => {
            const snippet = extractSnippet(r.body, query);
            return `
            <a href="${r.url}" class="search-result">
              <div class="search-result-header">
                <span class="type-badge">${r.type}</span>
                <time class="search-result-date">${new Date(r.date).toISOString().slice(0, 10)}</time>
              </div>
              <div class="search-result-title">${r.title}</div>
              ${snippet ? `<p class="search-result-snippet">${highlightMatches(snippet, query)}</p>` : ''}
              ${r.tags?.length ? `<div class="search-result-tags">${r.tags.map((t: string) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
            </a>
          `;
          }
        )
        .join('');
    });

    function escapeHtml(text: string): string {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function highlightMatches(text: string, query: string): string {
      const escaped = escapeHtml(text);
      const terms = query.split(/\s+/).filter(Boolean);
      let result = escaped;
      for (const term of terms) {
        const pattern = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        result = result.replace(
          new RegExp(`(${pattern})`, 'gi'),
          '<mark>$1</mark>'
        );
      }
      return result;
    }

    // Focus input on cmd+k or ctrl+k
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        input.focus();
      }
    });
  }

  initSearch();
</script>

<style>
  .page-title {
    margin-bottom: 2rem;
  }

  .search-input-wrapper {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: var(--font);
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.2s;

    &::placeholder {
      color: var(--text-dim);
    }

    &:focus {
      border-color: var(--accent);
    }
  }

  .search-status {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
  }

  .search-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .search-result {
    display: block;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid transparent;
    border-radius: var(--radius);
    transition: border-color 0.2s, border-left-color 0.2s, box-shadow 0.2s;
    color: inherit;

    &:hover {
      border-color: var(--border);
      border-left-color: var(--accent);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
      color: inherit;
    }
  }

  .search-result-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .search-result-date {
    font-size: 0.75rem;
    color: var(--accent-gold);
  }

  .search-result-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .search-result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .search-result-snippet {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  .no-results {
    color: var(--text-muted);
    font-style: italic;
    padding: 1rem 0;
  }
</style>
