---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all articles and projects">
  <div class="container container--narrow page">
    <h1 class="page-title">Search <span id="search-count" class="page-count" aria-hidden="true"></span></h1>
    <div id="search-container">
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          id="search-input"
          type="search"
          class="search-input"
          placeholder="Search articles and projects…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search articles and projects"
        />
        <button id="search-clear" class="search-clear" type="button" aria-label="清除搜尋" hidden>×</button>
        <kbd id="search-kbd" class="search-kbd" aria-hidden="true">Ctrl K</kbd>
      </div>
      <div class="search-meta">
        <span id="search-status" class="search-status" aria-live="polite" aria-atomic="true"></span>
      </div>
      <div id="search-results" class="search-results"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { tokenize, extractSnippet, escapeHtml, highlightMatches } from '../lib/search-client';
  import type { SearchDoc } from '../lib/search';

  const dateFormatter = new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });

  function formatDate(iso: string): { text: string; datetime: string } {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return { text: iso.slice(0, 10), datetime: iso };
    return { text: dateFormatter.format(d), datetime: d.toISOString() };
  }

  async function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results')!;
    const statusEl = document.getElementById('search-status')!;
    const countEl = document.getElementById('search-count')!;
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
    const kbdEl = document.getElementById('search-kbd')!;
    if (/mac|iphone|ipad/i.test(navigator.platform + ' ' + navigator.userAgent)) {
      kbdEl.textContent = '⌘K';
    }

    const MiniSearch = (await import('minisearch')).default;

    const miniSearch = new MiniSearch({
      fields: ['title', 'body'],
      storeFields: ['title', 'url', 'type', 'tags', 'date', 'body'],
      tokenize,
      processTerm: (term: string) => (term.length > 0 ? term : null),
      searchOptions: {
        boost: { title: 3, body: 1 },
        prefix: true,
        fuzzy: 0.15,
        combineWith: 'AND',
      },
    });

    const renderEmpty = () => {
      resultsEl.innerHTML = `
        <div class="search-empty">
          <span class="search-empty-icon" aria-hidden="true">∅</span>
          <h2 class="search-empty-title">空空如也</h2>
          <p class="search-empty-text">∵你還沒搜尋　∴什麼都沒有</p>
        </div>`;
    };

    const renderResults = (query: string, results: SearchDoc[]) => {
      statusEl.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;
      countEl.textContent = `${results.length}`;

      if (results.length === 0) {
        resultsEl.innerHTML = `
          <div class="search-no-results">
            <p class="search-no-results-text">揣無「${escapeHtml(query)}」</p>
          </div>`;
        return;
      }

      resultsEl.innerHTML = results
        .map((r) => {
          const snippet = extractSnippet(r.body, query);
          const { text, datetime } = formatDate(r.date);
          return `
          <a href="${r.url}" class="search-result">
            <div class="search-result-header">
              <span class="type-badge">${escapeHtml(r.type)}</span>
              <time class="search-result-date" datetime="${escapeHtml(datetime)}">${escapeHtml(text)}</time>
            </div>
            <h2 class="search-result-title">${highlightMatches(r.title, query)}</h2>
            ${snippet ? `<p class="search-result-snippet">${highlightMatches(snippet, query)}</p>` : ''}
            ${r.tags?.length ? `<div class="search-result-tags">${r.tags.map((t: string) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
          </a>`;
        })
        .join('');
    };

    let docs: SearchDoc[] = [];
    try {
      statusEl.textContent = 'Loading search index…';
      resultsEl.innerHTML = `<div class="search-skeleton" aria-hidden="true"><div class="search-skeleton-card"></div><div class="search-skeleton-card"></div><div class="search-skeleton-card"></div></div>`;
      const res = await fetch('/api/search-index.json');
      docs = await res.json();

      const CHUNK = 50;
      for (let i = 0; i < docs.length; i += CHUNK) {
        miniSearch.addAll(docs.slice(i, i + CHUNK));
        if (i + CHUNK < docs.length) {
          statusEl.textContent = `Indexing… ${Math.min(i + CHUNK, docs.length)}/${docs.length}`;
          await new Promise<void>((r) => requestAnimationFrame(() => r()));
        }
      }
    } catch {
      statusEl.textContent = 'Search index failed to load';
      resultsEl.innerHTML = `
        <div class="search-no-results">
          <p class="search-no-results-text">搜尋索引載入失敗 — 請重新整理再試一次。</p>
        </div>`;
      return;
    }

    statusEl.textContent = `${docs.length} documents indexed`;
    countEl.textContent = `${docs.length}`;

    const runSearch = (raw: string, { syncUrl = true } = {}) => {
      const query = raw.trim();
      clearBtn.hidden = query.length === 0;
      if (syncUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
      if (!query) {
        statusEl.textContent = `${docs.length} documents indexed`;
        countEl.textContent = `${docs.length}`;
        renderEmpty();
        return;
      }
      renderResults(query, miniSearch.search(query) as unknown as SearchDoc[]);
    };

    // Deep-link support (?q=), matching the SearchAction URL in BaseLayout.
    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
    if (initialQuery) input.value = initialQuery;
    renderEmpty();
    if (initialQuery) runSearch(initialQuery, { syncUrl: false });

    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => runSearch(input.value), 250);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      runSearch('');
      input.focus();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        input.focus();
      }
    });
  }

  initSearch();
</script>

<style>
  .page-title {
    margin-bottom: 2rem;
  }

  .page-count {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-dim);
    margin-inline-start: 0.5rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-dim);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 6rem 0.875rem 2.75rem;
    font-size: 1rem;
    font-family: var(--font);
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.2s ease;

    &::placeholder {
      color: var(--text-dim);
    }

    &:focus {
      border-color: var(--accent);
    }

    /* Keyboard focus gets the ring alone — not ring + tinted border. */
    &:focus-visible {
      border-color: var(--border);
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .search-clear {
    position: absolute;
    right: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--text-dim);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 150ms ease-out, transform 150ms ease-out;

    &:hover {
      color: var(--text);
    }

    &:active {
      transform: scale(0.97);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    &[hidden] {
      display: none;
    }
  }

  .search-kbd {
    position: absolute;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    padding: 0.15em 0.45em;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    pointer-events: none;
  }

  .search-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .search-status {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .search-kbd {
      display: none;
    }

    .search-input {
      padding-right: 2.75rem;
    }

    .search-clear {
      right: 0.75rem;
    }
  }
</style>
