---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import components from '../../components/mdx';
import { getCollection, getEntry, render } from 'astro:content';
import { countWords, isCjkChar, CJK_READING_SPEED, LATIN_READING_SPEED, CJK_THRESHOLD } from '../../lib/utils';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { id: article.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('articles', id);
const { Content } = await render(entry);

const bodyText = entry.body ?? '';
const wordCount = countWords(bodyText);
const stripped = bodyText
  .replace(/^---[\s\S]*?---/, '')
  .replace(/!\[.*?\]\(.*?\)/g, '')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[#*`>|~_-]/g, '')
  .replace(/\n+/g, ' ')
  .trim();
const cjkCount = [...stripped].filter((ch) => isCjkChar(ch.charCodeAt(0))).length;
const totalChars = stripped.replace(/\s/g, '').length || 1;
const isCjkDominant = cjkCount / totalChars > CJK_THRESHOLD;
const readingTime = Math.max(1, Math.round(wordCount / (isCjkDominant ? CJK_READING_SPEED : LATIN_READING_SPEED)));

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = allArticles.findIndex((a) => a.id === id);
const prev = currentIndex > 0 ? allArticles[currentIndex - 1] : null;
const next = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  body={entry.body ?? ''}
  tags={entry.data.tags}
  collection={entry.data.collection}
  readingTime={readingTime}
  prev={prev ? { title: prev.data.title, url: `/articles/${prev.id}/` } : undefined}
  next={next ? { title: next.data.title, url: `/articles/${next.id}/` } : undefined}
>
  <Content components={components} />
</ArticleLayout>
