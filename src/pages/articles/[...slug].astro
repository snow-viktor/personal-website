---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import components from '../../components/mdx';
import { getEntry, render } from 'astro:content';
import { getPublishedArticles } from '../../lib/content';
import { computeReadingTime } from '../../lib/utils';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { id: article.id, allArticles: articles },
  }));
}

const { id, allArticles } = Astro.props;
const entry = await getEntry('articles', id);
const { Content } = await render(entry);

const readingTime = computeReadingTime(entry.body ?? '');

const isVerse = entry.data.tags?.includes('free verse') ?? false;

const currentIndex = allArticles.findIndex((a) => a.id === id);
const prev = currentIndex > 0 ? allArticles[currentIndex - 1] : null;
const next = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  body={entry.body ?? ''}
  tags={entry.data.tags}
  collection={entry.data.collection}
  readingTime={readingTime}
  isVerse={isVerse}
  prev={prev ? { title: prev.data.title, url: `/articles/${prev.id}/` } : undefined}
  next={next ? { title: next.data.title, url: `/articles/${next.id}/` } : undefined}
>
  <Content components={components} />
</ArticleLayout>
