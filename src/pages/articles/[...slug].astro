---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import components from '../../components/mdx';
import { getEntry, render } from 'astro:content';
import { getPublishedArticles } from '../../lib/content';
import { computeReadingTime } from '../../lib/utils';

// Neighbor calculation happens here, not at render time: the base path never
// varies per query, and we avoid shipping every other article's body through
// each page's props just to find its neighbors.
export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      id: article.id,
      prev: index > 0 ? { title: articles[index - 1].data.title, url: `/articles/${articles[index - 1].id}/` } : undefined,
      next:
        index < articles.length - 1
          ? { title: articles[index + 1].data.title, url: `/articles/${articles[index + 1].id}/` }
          : undefined,
    },
  }));
}

const { id, prev, next } = Astro.props;
const entry = await getEntry('articles', id);
const { Content } = await render(entry);

const readingTime = computeReadingTime(entry.body ?? '');

const isVerse = entry.data.tags?.includes('free verse') ?? false;
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  body={entry.body ?? ''}
  tags={entry.data.tags}
  collection={entry.data.collection}
  readingTime={readingTime}
  isVerse={isVerse}
  prev={prev}
  next={next}
>
  <Content components={components} />
</ArticleLayout>
