---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="找不到這個頁面。">
  <div class="not-found">
    <h1 class="not-found-code">404</h1>
    <p class="not-found-message">This page wandered into the wrong repository.</p>
    <a href="/" class="not-found-home">Take me home</a>
    <p class="not-found-rickroll">
      <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" rel="noopener">
        Or maybe you'd prefer this &rarr;
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 2.75rem - 4rem - 4rem);
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .not-found-code {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .not-found-code {
      animation: float-404 4s ease-in-out infinite;
    }
  }

  @keyframes float-404 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .not-found-message {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 25rem;
  }

  .not-found-home {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    background: var(--accent-muted);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 100px;
    transition: background 0.2s, color 0.2s;

    &:hover {
      background: var(--accent);
      color: var(--bg);
    }
  }

  .not-found-rickroll {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
  }

  .not-found-rickroll a {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    transition: color 0.2s;

    &:hover {
      color: var(--text-muted);
    }
  }
</style>
