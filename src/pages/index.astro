---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedArticles, getPublishedProjects } from '../lib/content';
import { truncate } from '../lib/utils';
import { SITE } from '../config';

const allArticles = await getPublishedArticles();
const latestArticles = allArticles.slice(0, 4);

const allProjects = await getPublishedProjects();
const latestProjects = allProjects.slice(0, 4);

const heroName = SITE.name;
const heroSplitAt = 4;
const heroHead = heroName.slice(0, heroSplitAt);
const heroTail = heroName.slice(heroSplitAt);
---

<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="container container--narrow">
      <h1 class="hero-title">
        <span class="hero-name">
          {Array.from(heroHead).map((ch, i) => (
            <span class="hero-letter" style={`--i: ${i};`}>{ch}</span>
          ))}
          <span class="hero-mark">
            {Array.from(heroTail).map((ch, i) => (
              <span class="hero-letter" style={`--i: ${i + heroSplitAt};`}>{ch}</span>
            ))}
          </span>
        </span>
        <span class="hero-nickname">{SITE.nickName}</span>
      </h1>
      <p class="hero-description">
        I <em>will</em> become a smart and special person.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Latest Articles</h2>
        <a href="/articles/" class="section-link">View all</a>
      </div>
      <div class="grid-1">
        {latestArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            date={article.data.date}
            tags={article.data.tags}
            collection={article.data.collection}
            summary={article.body ?? ''}
            url={`/articles/${article.id}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--last">
    <div class="container">
      <div class="section-header">
        <h2>Recent Projects</h2>
        <a href="/projects/" class="section-link">View all</a>
      </div>
      <div class="grid-2">
        {latestProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            date={project.data.date}
            type={project.data.type}
            tags={project.data.tags}
            summary={truncate(project.body ?? '')}
            url={`/projects/${project.id}/`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    /* Stretch under the fixed header so the glow meets the nav's bottom edge. */
    margin-top: calc(-2.75rem - 1rem);
    padding: calc(6rem + 2.75rem + 1rem) 0 6rem;
  }

  /* Ambient hero glow: layered brand-hue radials, text stays solid. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(48rem 26rem at 14% -6%, rgba(228, 138, 74, 0.28), transparent 70%),
      radial-gradient(36rem 22rem at 88% 4%, rgba(122, 158, 192, 0.2), transparent 70%),
      radial-gradient(30rem 20rem at 60% 108%, rgba(212, 160, 96, 0.15), transparent 70%);
    pointer-events: none;
  }

  .hero > div {
    position: relative;
  }

  .hero-title {
    font-size: clamp(2.5rem, 1rem + 8vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    text-align: center;
    gap: 0.5rem 0.75rem;
    flex-wrap: wrap;
  }

  .hero-name {
    color: var(--text);
    white-space: nowrap;
  }

  .hero-letter {
    display: inline-block;
  }

  /* Hand-marker sweep behind the tail of the name — highlight, not type. */
  .hero-mark {
    background: linear-gradient(to top, rgba(228, 138, 74, 0.32) 0 32%, transparent 32% 100%);
    padding-bottom: 0.04em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-letter {
      animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 45ms + 100ms);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }

  .hero-nickname {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .hero-description {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .section {
    margin-top: 2rem;
  }

  .section + .section {
    margin-top: 3rem;
  }

  .section--last {
    margin-bottom: 4rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-accent);
    position: relative;
  }

  .section-header::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .section-header h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0;
  }

  .section-link {
    font-size: 0.8125rem;
    color: var(--text-dim);

    &:hover {
      color: var(--accent);
    }
  }

  .grid-1 {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: calc(4rem + 2.75rem + 1rem) 0 4rem;
    }

    .hero::before {
      opacity: 0.7;
    }

    .hero-title {
      gap: 0.25rem 0.5rem;
    }

    .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
